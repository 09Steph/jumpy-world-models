# Caches and compiled files
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Coverage
.coverage
.coverage.*
htmlcov/

# Run artefacts. Keep the directory, not the contents.
outputs/*
!outputs/.gitkeep

# Offline datasets. Directory kept, not the contents.
datasets/*
!datasets/.gitkeep

# Result artefacts, kept off the repository. Directory kept, not the contents.
results/*
!results/.gitkeep

# Local diagnostic scripts, not shipped
temp_files/

# Test suite
/tests

# Editors
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Notebooks
.ipynb_checkpoints/

# Local environments (managed via environment.yml)
.venv/
venv/
env/

# Operational scripts, kept local
/scripts